{
  "name": "claudegravity",
  "version": "1.0.0",
  "description": "Plan, Review, Bau und Abnahme mit getrennten KI-Anbietern (Claude, Antigravity, Codex, Ollama, eigene Server): kein Modell benotet sich selbst.",
  "author": { "name": "gb-web-de", "url": "https://github.com/gb-web-de" },
  "homepage": "https://github.com/gb-web-de/claudegravity-loop",
  "repository": "https://github.com/gb-web-de/claudegravity-loop",
  "license": "MIT",
  "keywords": ["loop", "multi-model", "code-review", "ollama", "codex", "antigravity", "mcp"],
  "mcpServers": {
    "claudegravity": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp_server.py"],
      "env": { "PYTHONIOENCODING": "utf-8", "CLAUDEGRAVITY_HOST": "claude" }
    }
  }
}
